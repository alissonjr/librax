{
  "name": "@librax/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Librax backend - logica de dominio server-authoritative (SPEC 02 + SPEC 04). Pura e testavel; adaptadores AWS ficam na borda.",
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "catalog": "node scripts/build-catalog.mjs",
    "emails:previa": "node scripts/email-previews.mjs",
    "local": "node local/server.mjs",
    "local:up": "node local/cli.mjs up",
    "local:down": "node local/cli.mjs down",
    "local:reset": "node local/cli.mjs reset",
    "local:jobs": "node local/cli.mjs jobs",
    "local:status": "node local/cli.mjs status",
    "test:e2e": "node --test e2e/local.e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1156.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1156.0",
    "@aws-sdk/client-cost-explorer": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
