# Painel de administracao (copie para .env.local). Valores vem dos outputs do CDK.
# Dominio do Cognito (output AuthDomain), sem https://
VITE_COGNITO_DOMAIN=auth.librax.example
# App client do painel (output AdminClientId), diferente do client do app
VITE_COGNITO_CLIENT_ID=
# API na mesma origem (CloudFront /api/*)
VITE_API_BASE=/api
