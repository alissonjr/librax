# Copie para .env.local (não versionado) e preencha com as saídas do `cdk deploy`
# (infra/lib/librax-stack.ts, seção "Outputs"). Sem as três VITE_COGNITO_*, o app roda
# só como convidado: o login fica desligado e a fila de sincronização só guarda.

# Output UserPoolId
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# Output UserPoolClientId
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Output AuthDomain, sem https:// (domínio próprio do Cognito, ex.: auth.librax.example)
VITE_COGNITO_DOMAIN=auth.librax.example

# Opcionais: por padrão <origem>/auth/callback e <origem>/. Precisam estar na lista de
# callbacks/logouts do app client (em dev local: -c librax:extraCallbackUrls=...).
# VITE_AUTH_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback
# VITE_AUTH_REDIRECT_SIGN_OUT=http://localhost:5173/

# Prefixo da API. Em produção é a mesma origem (CloudFront /api/*), então /api.
# Em dev local, aponte para o domínio publicado e libere a origem com
# -c librax:extraCorsOrigins=http://localhost:5173.
VITE_API_BASE=/api

# Chave pública VAPID (a mesma guardada em /librax/vapid/public-key no SSM). Usada pelo
# cliente de Web Push quando ele for ligado (fase W4).
VITE_VAPID_PUBLIC_KEY=
