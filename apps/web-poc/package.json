{
  "name": "librax-web-poc",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "tokens": "node ../../tools/tokens/build.mjs",
    "tokens:check": "node ../../tools/tokens/build.mjs --check && node ../../tools/tokens/check-contrast.mjs",
    "contrast": "node ../../tools/tokens/check-contrast.mjs --verbose",
    "icons": "node ../../tools/icons/build.mjs",
    "ml:assets": "node scripts/ml-assets.mjs",
    "predev": "npm run tokens && npm run ml:assets",
    "dev": "vite",
    "predev:celular": "npm run tokens && npm run ml:assets",
    "dev:celular": "vite --mode celular",
    "prebuild": "npm run tokens && node ../../tools/tokens/check-contrast.mjs && npm run ml:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "animate.css": "^4.1.1",
    "idb": "^8.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@material-symbols/svg-500": "^0.48.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0"
  }
}
